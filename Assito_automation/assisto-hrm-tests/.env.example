# Assisto HRM Portal Test Environment Configuration
# Copy this file to .env and fill in your actual values

# Base URL for the Assisto HRM application
BASE_URL=http://nsplus.perf.devassisto.com

# Login URL path
LOGIN_URL=/login

# Test admin credentials
ADMIN_EMAIL=testadmin@example.com
ADMIN_PASSWORD=TestAdmin@123

# MailSac API Key (get from https://mailsac.com/api-keys after free signup).
# Used by utils/mailGrabber.ts for the self-service registration ("Start Free
# Trial") flow, which needs a brand-new disposable mailbox per run.
# Never commit a real key — .env is gitignored, this file holds a placeholder.
MAIL_SAC_API_KEY=your_mailsac_api_key

# Real private mailbox used by MailSacClient for email-based test verification
# (MailSac's free quota can run out; this is a fallback backed by a real,
# authenticated inbox instead of a public/anonymous disposable-mail service).
# TEST_MAIL_ADDRESS is a Gmail address; TEST_MAIL_APP_PASSWORD is a Gmail
# App Password (Google Account > Security > 2-Step Verification > App passwords
# - requires 2-Step Verification to be enabled first).
TEST_MAIL_ADDRESS=youraddress@gmail.com
TEST_MAIL_APP_PASSWORD=your16charapppassword

# Public Assisto portal hosting the self-service registration ("Start Free
# Trial") flow. Distinct from BASE_URL, which points at a provisioned tenant.
REGISTRATION_URL=https://test.devassisto.com


# Trial admin account used by tests/login/login.spec.ts. Provision one by
# running tests/registration/registration.spec.ts and copy the generated
# email/password here. Never commit real values.
TRIAL_ADMIN_EMAIL=trialadmin@mailsac.com
TRIAL_ADMIN_PASSWORD=your_trial_admin_password
